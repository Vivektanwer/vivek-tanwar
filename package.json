    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "sirv": "^3.0.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.0.0",
    "vite": "^7.0.6"
